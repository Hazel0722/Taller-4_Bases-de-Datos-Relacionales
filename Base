-- Consulta 1: Estudiantes con sus cursos
SELECT E.nombre AS Estudiante, C.nombre AS Curso
FROM Matricula M
INNER JOIN Estudiante E ON M.idEstudiante = E.idEstudiante
INNER JOIN Grupo G ON M.idGrupo = G.idGrupo
INNER JOIN Curso C ON G.idCurso = C.idCurso;

--Consulta 2: Cantidad de estudiantes por curso
SELECT C.nombre AS Curso, COUNT(M.idEstudiante) AS TotalEstudiantes
FROM Curso C
INNER JOIN Grupo G ON C.idCurso = G.idCurso
INNER JOIN Matricula M ON G.idGrupo = M.idGrupo
GROUP BY C.nombre;

--Consulta 3: Cursos con más de 1 estudiante
SELECT C.nombre AS Curso, COUNT(M.idEstudiante) AS TotalEstudiantes
FROM Curso C
INNER JOIN Grupo G ON C.idCurso = G.idCurso
INNER JOIN Matricula M ON G.idGrupo = M.idGrupo
GROUP BY C.nombre
HAVING COUNT(M.idEstudiante) > 1;

--Consulta 4. Profesor con más grupos
SELECT 
    P.nombre AS Profesor,
    COUNT(G.idGrupo) AS TotalGrupos
FROM Profesor P
INNER JOIN Grupo G ON P.idProfesor = G.idProfesor
GROUP BY P.nombre
ORDER BY TotalGrupos DESC;




